# 校园助手后端生产环境变量模板（M00.01）
# 复制到部署环境的密钥管理或 .env（.env 不得提交到仓库），并填入真实值。
# 缺少必填项时应用会以 CONFIGURATION_INVALID 拒绝启动。

# 运行 profile：生产必须为 prod
SPRING_PROFILES_ACTIVE=prod

# 数据库（MySQL 8.4）
CAMPUS_DB_URL=jdbc:mysql://127.0.0.1:3306/campus_assistant?useSSL=true&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true&rewriteBatchedStatements=true
CAMPUS_DB_USERNAME=CHANGE_ME
CAMPUS_DB_PASSWORD=CHANGE_ME

# 缓存（Valkey/Redis 协议）
CAMPUS_REDIS_HOST=127.0.0.1
CAMPUS_REDIS_PORT=6379
CAMPUS_REDIS_DATABASE=0
CAMPUS_REDIS_PASSWORD=CHANGE_ME
CAMPUS_MYBATIS_ENCRYPTOR_PASSWORD=CHANGE_ME

# 支付网关：取值 mock 会在生产被启动守卫拒绝
CAMPUS_PAYMENT_GATEWAY=wechat
CAMPUS_PAYMENT_ORDER_NOTIFY_URL=https://api.example.com/admin-api/pay/notify/order
CAMPUS_PAYMENT_REFUND_NOTIFY_URL=https://api.example.com/admin-api/pay/notify/refund
CAMPUS_PAYMENT_TRANSFER_NOTIFY_URL=https://api.example.com/admin-api/pay/notify/transfer

# 微信配置（生产必填；示例值不可用于部署）
CAMPUS_WECHAT_MP_APP_ID=CHANGE_ME
CAMPUS_WECHAT_MP_SECRET=CHANGE_ME
CAMPUS_WECHAT_MINIAPP_APP_ID=CHANGE_ME
CAMPUS_WECHAT_MINIAPP_SECRET=CHANGE_ME
CAMPUS_WECHAT_CONNECT_TIMEOUT=3s
CAMPUS_WECHAT_READ_TIMEOUT=5s

# 学生端会员与 OAuth 数据所属的平台租户（由服务端固定，不读取客户端 tenant header）
CAMPUS_PLATFORM_TENANT_ID=1

# transactional outbox worker（使用 Quartz 作为唯一触发器时将 WORKER_ENABLED 设为 false）
CAMPUS_OUTBOX_WORKER_ENABLED=true
CAMPUS_OUTBOX_WORKER_ID=campus-local
CAMPUS_OUTBOX_POLL_INTERVAL_MS=1000
CAMPUS_OUTBOX_BATCH_SIZE=50
CAMPUS_OUTBOX_MAX_ATTEMPTS=8
CAMPUS_OUTBOX_LEASE_DURATION=30s
CAMPUS_OUTBOX_INITIAL_BACKOFF=1s
CAMPUS_OUTBOX_MAX_BACKOFF=5m

# 可选：服务端口（默认 48080）
CAMPUS_SERVER_PORT=48080
