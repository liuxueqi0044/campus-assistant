{
  "easycom": {
    "autoscan": true,
    "custom": { "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue" }
  },
  "pages": [
    { "path": "pages/index/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/timetable/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/messages/index", "style": { "navigationStyle": "custom" } },
    { "path": "pages/me/index", "style": { "navigationStyle": "custom" } }
  ],
  "subPackages": [
    { "root": "pages-market", "pages": [{ "path": "detail" }, { "path": "publish" }] },
    { "root": "pages-errand", "pages": [{ "path": "detail" }, { "path": "publish" }] },
    { "root": "pages-activity", "pages": [{ "path": "detail" }, { "path": "publish" }] },
    { "root": "pages-timetable", "pages": [{ "path": "course" }, { "path": "import" }] },
    { "root": "pages-message", "pages": [{ "path": "chat" }, { "path": "notices" }] },
    {
      "root": "pages-account",
      "pages": [
        { "path": "login" },
        { "path": "verify" },
        { "path": "settings" },
        { "path": "records" }
      ]
    }
  ],
  "globalStyle": {
    "navigationStyle": "custom",
    "backgroundColor": "#f7f8f7",
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "校园助手"
  }
}
